# Copy to .env.local and configure privately. Empty values are intentional.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy public key; publishable key takes priority.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

N8N_WEBHOOK_URL=http://localhost:5678/webhook/careerai-cv
N8N_ANALYSIS_WEBHOOK_URL=http://localhost:5678/webhook/careerai-cv-analysis
N8N_JOBS_WEBHOOK_URL=http://localhost:5678/webhook/careerai-jobs
N8N_DOCUMENTS_WEBHOOK_URL=http://localhost:5678/webhook/careerai-documents
N8N_ASSISTANT_WEBHOOK_URL=http://localhost:5678/webhook/careerai-assistant
N8N_WEBHOOK_SECRET=

# Optional privileged server-side scheduler storage. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
